APP_ENV=development
SECRET_KEY=signalx-super-secret-key-change-in-production
DEBUG=True

# Database URL: defaults to local SQLite for instant out-of-the-box operation, or PostgreSQL asyncpg
DATABASE_URL=sqlite+aiosqlite:///./signalx.db

# Market Data Provider
# Supported: "mock" (simulated live NIFTY ticks/candles), "yfinance" (Yahoo Finance API), "kite" (Zerodha Kite Connect)
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
MARKET_DATA_BASE_URL=

# Zerodha Kite Connect Settings
KITE_API_KEY=
KITE_ACCESS_TOKEN=
KITE_INSTRUMENT_TOKEN=256265

# Paper Trading & Risk Configuration
INITIAL_CAPITAL=100000.0
DEFAULT_TIMEFRAME=5m
PREDICTION_HORIZON_MINUTES=15

# Signal & Risk Thresholds
BUY_THRESHOLD=0.65
SELL_THRESHOLD=0.65
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.02
SLIPPAGE_BPS=5.0
MAX_OPEN_POSITIONS=1

# Data Freshness (seconds)
MAX_DATA_AGE_SECONDS=15
